{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Aria Bridge",
  "version": "0.1.7",
  "identifier": "com.mirrorbloom.ylxtransfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Open Aria Bridge",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi"],
    "resources": ["resources/THIRD_PARTY_NOTICES.md", "resources/windows-ffmpeg.json"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5OTcyODA3RDJGNDc4QjAKUldTd2VQVFNCeWlYZWU0ZElkMndCVWpubXE1NExwSEpqK1FsRkFBK29GNWo0b09PbUkwcGJ2a08K",
      "endpoints": ["https://github.com/Alpenl/openaria-bridge-desktop/releases/latest/download/latest.json"]
    }
  }
}
