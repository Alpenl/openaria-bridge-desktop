{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ylx:schema:device-session:v2",
  "title": "YLX Sealed Device Session Manifest v2",
  "description": "Device Session v2 keeps v1 sealed video/take/integrity semantics, corrects raw IMU axes to raw_device_axes, and adds a closed explicit audio state. Audio segment duration is a product/config decision, not a schema constant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "sealed",
    "sealed_at",
    "session_id",
    "volume_id",
    "capture_mode",
    "display_name",
    "device",
    "time",
    "take",
    "camera",
    "video",
    "imu",
    "frames",
    "audio",
    "logs",
    "integrity"
  ],
  "properties": {
    "schema": {"const": "ylx.device-session.v2"},
    "manifest_id": {"$ref": "#/$defs/uuidV7"},
    "sealed": {"const": true},
    "sealed_at": {"type": "string", "format": "date-time"},
    "session_id": {"$ref": "#/$defs/uuidV7"},
    "volume_id": {"$ref": "#/$defs/uuidV4"},
    "capture_mode": {"enum": ["production", "calibration"]},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_label",
        "hardware_fingerprint",
        "platform",
        "software_version",
        "commit"
      ],
      "properties": {
        "device_id": {"$ref": "#/$defs/uuidV4"},
        "device_label": {"type": "string", "pattern": "^YLX-[0-9A-F]{8}$"},
        "hardware_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {"type": "string", "minLength": 1, "maxLength": 128},
        "software_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "timezone", "duration_seconds"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "timezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+$"
        },
        "duration_seconds": {"type": "number", "minimum": 0},
        "duration_clock": {"const": "host_monotonic"}
      }
    },
    "take": {"$ref": "#/$defs/take"},
    "camera": {"$ref": "#/$defs/camera"},
    "video": {
      "oneOf": [
        {"$ref": "#/$defs/splitEyesVideo"},
        {"$ref": "#/$defs/rawSideBySideVideo"}
      ]
    },
    "imu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sample_count", "units", "coordinate_frame"],
      "properties": {
        "artifact": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "role": {"const": "imu.samples"},
                "media_type": {"const": "application/x-ndjson"}
              }
            }
          ]
        },
        "sample_count": {"type": "integer", "minimum": 0},
        "units": {"const": "raw_int16"},
        "coordinate_frame": {"const": "raw_device_axes"}
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "count"],
      "properties": {
        "artifact": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "role": {"const": "frames.index"},
                "media_type": {"const": "application/x-ndjson"}
              }
            }
          ]
        },
        "count": {"type": "integer", "minimum": 0}
      }
    },
    "audio": {
      "oneOf": [
        {"$ref": "#/$defs/recordedAudio"},
        {"$ref": "#/$defs/notRecordedAudio"}
      ]
    },
    "logs": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/artifact"},
          {"properties": {"role": {"pattern": "^log(?:[._-][a-z0-9]+)+$"}}}
        ]
      }
    },
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidV4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "allOf": [
        {"not": {"pattern": "^(?:manifest\\.json|recording\\.json)(?:/|$)"}},
        {"not": {"pattern": "(?:^|/)[^/]*\\.tmp(?:[._-][^/]*)?(?:/|$)"}}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "role", "path", "media_type", "bytes", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/sha256"},
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
          "maxLength": 96
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "take": {
      "type": "object",
      "additionalProperties": false,
      "required": ["take_id", "sequence", "continuation_of"],
      "oneOf": [
        {
          "properties": {
            "sequence": {"const": 1},
            "continuation_of": {"type": "null"}
          }
        },
        {
          "properties": {
            "sequence": {"type": "integer", "minimum": 2},
            "continuation_of": {"$ref": "#/$defs/uuidV7"}
          }
        }
      ],
      "properties": {
        "take_id": {"$ref": "#/$defs/uuidV7"},
        "sequence": {"type": "integer", "minimum": 1},
        "continuation_of": {
          "oneOf": [{"$ref": "#/$defs/uuidV7"}, {"type": "null"}]
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "eye_width",
        "sensor_fps",
        "frame_decimation",
        "effective_fps",
        "coordinate_frame"
      ],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "eye_width": {"type": "integer", "minimum": 1},
        "sensor_fps": {"type": "number", "exclusiveMinimum": 0},
        "frame_decimation": {"type": "integer", "minimum": 1},
        "nominal_fps": {"type": "number", "exclusiveMinimum": 0},
        "effective_fps": {"type": "number", "minimum": 0},
        "coordinate_frame": {"const": "opencv_optical"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_at",
        "dropped_frames",
        "drop_events",
        "fatal_errors"
      ],
      "properties": {
        "verified_at": {"type": "string", "format": "date-time"},
        "dropped_frames": {"type": "integer", "minimum": 0},
        "drop_events": {"type": "array", "items": {"$ref": "#/$defs/dropEvent"}},
        "quality_policy": {"$ref": "#/$defs/qualityPolicy"},
        "media_write_throughput_bytes_per_second": {
          "type": "integer",
          "minimum": 0
        },
        "fatal_errors": {"const": []}
      }
    },
    "qualityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "max_contiguous_dropped_frames",
        "max_total_dropped_frames",
        "max_drop_fraction",
        "window_seconds",
        "max_dropped_frames_per_window"
      ],
      "properties": {
        "policy_id": {"const": "rdk-x5-lossless-v1"},
        "max_contiguous_dropped_frames": {"const": 0},
        "max_total_dropped_frames": {"const": 0},
        "max_drop_fraction": {"const": 0},
        "window_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_dropped_frames_per_window": {"const": 0}
      }
    },
    "splitEyesVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "codec", "container", "segments"],
      "properties": {
        "layout": {"const": "split-eyes"},
        "codec": {"const": "h264"},
        "container": {"const": "mp4"},
        "segments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stereoSegment"}
        }
      }
    },
    "rawSideBySideVideo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "codec", "continuous", "artifact"],
      "properties": {
        "layout": {"const": "raw-side-by-side"},
        "codec": {"const": "mjpeg"},
        "continuous": {"const": true},
        "artifact": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "role": {"const": "video.raw-side-by-side"},
                "media_type": {"const": "video/x-motion-jpeg"}
              }
            }
          ]
        }
      }
    },
    "stereoSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_frame",
        "end_frame",
        "start_time_seconds",
        "end_time_seconds",
        "artifacts"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 1},
        "start_time_seconds": {"type": "number", "minimum": 0},
        "end_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {
              "allOf": [
                {"$ref": "#/$defs/artifact"},
                {
                  "properties": {
                    "role": {"const": "video.left"},
                    "media_type": {"const": "video/mp4"}
                  }
                }
              ]
            },
            "right": {
              "allOf": [
                {"$ref": "#/$defs/artifact"},
                {
                  "properties": {
                    "role": {"const": "video.right"},
                    "media_type": {"const": "video/mp4"}
                  }
                }
              ]
            }
          }
        }
      }
    },
    "dropEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "at_time_seconds", "reason", "dropped"],
      "properties": {
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 1},
        "at_time_seconds": {"type": "number", "minimum": 0},
        "reason": {"const": "write_backpressure"},
        "dropped": {"type": "integer", "minimum": 1}
      }
    },
    "recordedAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "requested_mode",
        "resolved_mode",
        "codec",
        "container",
        "sample_format",
        "sample_rate",
        "channels",
        "sample_count",
        "sync",
        "segments"
      ],
      "properties": {
        "state": {"const": "recorded"},
        "requested_mode": {"enum": ["device_default", "enabled"]},
        "resolved_mode": {"const": "enabled"},
        "codec": {"const": "pcm_s16le"},
        "container": {"const": "wav"},
        "sample_format": {"const": "S16_LE"},
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 384000},
        "channels": {"type": "integer", "minimum": 1, "maximum": 8},
        "sample_count": {"type": "integer", "minimum": 1},
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_base",
            "start_time_seconds",
            "end_time_seconds",
            "video_time_reference"
          ],
          "properties": {
            "time_base": {"const": "host_monotonic"},
            "start_time_seconds": {"type": "number", "minimum": 0},
            "end_time_seconds": {"type": "number", "exclusiveMinimum": 0},
            "video_time_reference": {"const": "session_time_seconds"}
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/audioSegment"}
        }
      }
    },
    "notRecordedAudio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requested_mode", "resolved_mode", "reason"],
      "properties": {
        "state": {"const": "not_recorded"},
        "requested_mode": {"enum": ["device_default", "disabled"]},
        "resolved_mode": {"const": "disabled"},
        "reason": {"enum": ["user_disabled", "device_default_disabled"]}
      }
    },
    "audioSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_sample",
        "end_sample",
        "start_time_seconds",
        "end_time_seconds",
        "pcm_payload_bytes",
        "wav_header_bytes",
        "artifact"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "minimum": 1},
        "start_time_seconds": {"type": "number", "minimum": 0},
        "end_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "pcm_payload_bytes": {"type": "integer", "minimum": 1},
        "wav_header_bytes": {"type": "integer", "minimum": 44, "maximum": 65536},
        "artifact": {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "role": {"const": "audio.wav"},
                "media_type": {"const": "audio/wav"}
              }
            }
          ]
        }
      }
    }
  }
}
