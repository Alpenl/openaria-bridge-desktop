{
  "name": "ylx-transfer",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node ./src/test-support/run-tests.mjs",
    "release:check": "node --test scripts/desktop-release-contract.test.mjs scripts/desktop-release-postverify.test.mjs scripts/dispatch-desktop-release.test.mjs scripts/windows-updater-acceptance.test.mjs && node scripts/desktop-release-contract.mjs validate-versions",
    "contracts:test": "node --test scripts/device-api-contract.test.mjs",
    "contracts:check": "node ./scripts/validate-device-api-contract.mjs && node ./scripts/generate-device-session-contract-identity.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "js-yaml": "5.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "5.3.0",
    "nanoid": "3.3.18"
  }
}
